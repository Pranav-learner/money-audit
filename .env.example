# ── PostgreSQL Database Configuration ──
POSTGRES_DB=finance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finance_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ── JWT Authentication ──
# 256-bit or longer secret key
JWT_SECRET=thisIsASecretKeyForFinanceTrackerProject123456
JWT_EXPIRATION=86400000

# ── Mail Configuration (SMTP) ──
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# ── Razorpay Payment Gateway ──
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR

# ── Cloudinary (Optional - local disk fallback is used when omitted) ──
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Tesseract OCR ──
TESSDATA_PREFIX=/usr/share/tessdata
OCR_LANGUAGE=eng
RECEIPT_UPLOAD_DIR=uploads/receipts

# ── Server Port ──
PORT=8080
